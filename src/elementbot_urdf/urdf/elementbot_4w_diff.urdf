<!-- 
    長　25m
    寬　15m
    高　12m
    離地　1m
 -->
<robot name="elementbot_4w_diff">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.041 0.138 0.23 0.99"/>
  </material>
  <!-- base_link -->
  <link name="base_footprint">
    <visual>
        <geometry>
            <sphere radius="0.001"/>
        </geometry>
    </visual>
  </link>

  <!-- base_link -->
  <link name="base_link">
    <visual>
        <geometry>
            <box size="0.25 0.15 0.12"/>
        </geometry>
        <material name="blue"/>
    </visual>
  </link>

  <joint name="base_link2base_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- z的偏移量＝(車體高度/2)+底盤離地間距 -->
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- left_front_wheel_link -->
  <link name="left_front_wheel_link">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>   
      </geometry>
      <origin rpy="1.57 0.0 0.0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <!-- z=車體高度/2 + 離地間距 - 車輪半徑 -->
    <origin xyz="0.07 0.06 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- right_front_wheel_link -->
  <link name="right_front_wheel_link">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <origin rpy="1.57 0.0 0.0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <!-- z=車體高度/2 + 離地間距 - 車輪半徑 -->
    <origin xyz="0.07 -0.06 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- left_back_wheel_link -->
  <link name="left_back_wheel_link">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <origin rpy="1.57 0.0 0.0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_back_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_back_wheel_link"/>
    <!-- z=車體高度/2 + 離地間距 - 車輪半徑 -->
    <origin xyz="-0.07 -0.06 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- right_back_wheel_link -->
  <link name="right_back_wheel_link">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <origin rpy="1.57 0.0 0.0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_back_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_back_wheel_link"/>
    <!-- z=車體高度/2 + 離地間距 - 車輪半徑 -->
    <origin xyz="-0.07 0.06 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>