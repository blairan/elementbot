<robot name="elementbot_4w_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define materials -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.041 0.138 0.23 0.99"/>
  </material>

  <!-- Define parameters -->
  <xacro:property name="base_length" value="0.25"/>
  <xacro:property name="base_width" value="0.15"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_length" value="0.025"/>
  <xacro:property name="wheel_separation_width" value="0.12"/>
  <xacro:property name="wheel_separation_length" value="0.14"/>
  <xacro:property name="wheel_offset" value="0.03"/>
  <xacro:property name="base_offset" value="0.07"/>
  <xacro:property name="PI" value="3.14159"/>

  <!-- Base footprint -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="base_link2base_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height / 2 + wheel_offset}"/>
  </joint>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="name position_x position_y">
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
        <origin rpy="${PI/2} 0 0"/>
        <material name="black"/>
      </visual>
    </link>

    <joint name="${name}_joint" type="continuous">
      <origin xyz="${position_x} ${position_y} -${wheel_offset}"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Front left wheel -->
  <xacro:wheel name="left_front" position_x="${base_offset}" position_y="${wheel_separation_width / 2}"/>

  <!-- Front right wheel -->
  <xacro:wheel name="right_front" position_x="${base_offset}" position_y="-${wheel_separation_width / 2}"/>

  <!-- Back left wheel -->
  <xacro:wheel name="left_back" position_x="-${base_offset}" position_y="${wheel_separation_width / 2}"/>

  <!-- Back right wheel -->
  <xacro:wheel name="right_back" position_x="-${base_offset}" position_y="-${wheel_separation_width / 2}"/>

</robot>